<Window x:Class="FastEthernetTransfer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FastEthernetTransfer.Wpf.ViewModels"
        xmlns:views="clr-namespace:FastEthernetTransfer.Wpf.Views"
        xmlns:models="clr-namespace:FastEthernetTransfer.Core.Models;assembly=FastEthernetTransfer.Core"
        mc:Ignorable="d"
        Title="Fast Ethernet File Transfer - High Speed PC-to-PC"
        Height="800" Width="1100" MinHeight="680" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/newappicon.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Background Ambient Glow -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="450" Height="450" Fill="#00D2FF" Opacity="0.03" Canvas.Left="-100" Canvas.Top="-100" />
            <Ellipse Width="550" Height="550" Fill="#2563EB" Opacity="0.03" Canvas.Right="-150" Canvas.Bottom="-150" />
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Navigation Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Main Content Area -->
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- 1. LEFT SIDEBAR NAVIGATION                                -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- App Brand / Logo -->
                        <RowDefinition Height="Auto" /> <!-- Local PC Status Card -->
                        <RowDefinition Height="*" />    <!-- Navigation Items -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Utilities & Theme Toggle -->
                    </Grid.RowDefinitions>

                    <!-- App Brand -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/newappicon.ico" Width="26" Height="26" Margin="0,0,8,0" />
                            <TextBlock Text="Fast Ethernet" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="34,2,0,0">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="v2.0 • Max Speed" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Local PC Status Badge -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocalDeviceName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            </StackPanel>
                            <TextBlock Text="{Binding LocalAdapterName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding LocalLinkSpeed}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                <TextBlock Text=" • " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding LocalIp}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8" />

                        <!-- Transfer Tab -->
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding CurrentNavSection, Converter={StaticResource EnumToBool}, ConverterParameter=Transfer}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Transfer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Transfer" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Game Updater Tab -->
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding CurrentNavSection, Converter={StaticResource EnumToBool}, ConverterParameter=GameUpdater}"
                                     Command="{Binding NavigateCommand}" CommandParameter="GameUpdater">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Game Updater" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Activity Tab -->
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding CurrentNavSection, Converter={StaticResource EnumToBool}, ConverterParameter=Activity}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Activity">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Activity" FontSize="13" VerticalAlignment="Center" />
                                <Border Style="{StaticResource NavBadge}" Visibility="{Binding TransferHistory.Count, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TransferHistory.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <!-- Settings Tab -->
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding CurrentNavSection, Converter={StaticResource EnumToBool}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Bottom Utilities -->
                    <StackPanel Grid.Row="3">
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                        <!-- Theme Toggle Button -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IsDarkTheme, Converter={x:Null}, StringFormat='{}🌙 Dark Theme'}" Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVis}}" FontSize="12" />
                                <TextBlock Text="☀️ Light Theme" Visibility="{Binding IsDarkTheme, Converter={StaticResource InverseBoolToVis}}" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Refresh Network Button -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshNetworkCommand}" HorizontalContentAlignment="Left" Padding="10,8" ToolTip="Refresh Ethernet adapters">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 Refresh Network" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- 2. MAIN CONTENT AREA (Section Based)                      -->
            <!-- ======================================================== -->
            <Grid Grid.Column="1" Margin="24">

                <!-- #################################################### -->
                <!-- SECTION 1: TRANSFER (Send & Receive Files)           -->
                <!-- #################################################### -->
                <Grid Visibility="{Binding CurrentNavSection, Converter={StaticResource EnumToVis}, ConverterParameter=Transfer}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Discovered LAN Peers Bar -->
                        <RowDefinition Height="*" />    <!-- DropZone & Queue OR Live Transfer -->
                        <RowDefinition Height="Auto" /> <!-- Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- 1.1 Discovered LAN Peers Bar -->
                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Connected Peers:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Border Background="#1E293B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding OnlinePeers.Count}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Peer Selector / Cards -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Empty peer message -->
                                    <TextBlock Text="Searching for PCs on Ethernet network..." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Visibility="{Binding OnlinePeers.Count, Converter={StaticResource InverseBoolToVis}}" />

                                    <!-- Discovered Peer Pills -->
                                    <ItemsControl ItemsSource="{Binding OnlinePeers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Margin="0,0,8,0" Padding="10,6"
                                                        Background="{DynamicResource CardBgHoverBrush}"
                                                        BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1"
                                                        Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftClick"
                                                                      Command="{Binding DataContext.SelectPeerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🖥" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <Border Background="#064E3B" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LinkSpeedFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Benchmark & Quick Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⚡ Benchmark" Style="{StaticResource SecondaryButton}" Click="OnOpenBenchmarkClick" Padding="10,5" Margin="0,0,6,0" />
                                <Button Content="📜 Logs" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogsCommand}" Padding="10,5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 1.2 Main Area: Setup & Queue OR Active Transfer -->
                    <Grid Grid.Row="1">

                        <!-- View A: Selection, Drag-and-Drop & Send Mode -->
                        <Border Style="{StaticResource GlassCard}" Visibility="{Binding IsTransferActive, Converter={StaticResource InverseBoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Selected Target Peer Header -->
                                    <RowDefinition Height="Auto" /> <!-- Drag & Drop Zone -->
                                    <RowDefinition Height="*" />    <!-- Queue List -->
                                    <RowDefinition Height="Auto" /> <!-- Send Action Bar -->
                                </Grid.RowDefinitions>

                                <!-- Target Peer Indicator -->
                                <Border Grid.Row="0" Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Target PC: " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedPeer.DeviceName, FallbackValue='(Select a PC from the top bar)'}"
                                                       FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentCyanBrush}" Margin="4,0,0,0" />
                                            <TextBlock Text="{Binding SelectedPeer.LinkSpeedFormatted, StringFormat='{} [{0}]'}"
                                                       FontSize="12" Foreground="{StaticResource AccentEmeraldBrush}" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedPeer.IpAddress}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Drag-and-Drop Zone -->
                                <Border Grid.Row="1" Style="{StaticResource DropZoneBorder}" Margin="0,0,0,12"
                                        AllowDrop="True" Drop="OnDropZoneDrop" DragOver="OnDropZoneDragOver" DragLeave="OnDropZoneDragLeave"
                                        BorderBrush="{Binding IsDragOver, Converter={x:Null}, FallbackValue={StaticResource BorderLightBrush}}"
                                        Cursor="Hand">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="📥 " FontSize="18" />
                                                <TextBlock Text="Drag and drop files or folders here" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Supports multiple files, nested folders, and 100+ GB directories with streaming transfer."
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📄 Browse Files" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SelectFilesCommand}" Margin="0,0,8,0" Padding="14,8" />
                                            <Button Content="📁 Browse Folder" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding SelectFolderCommand}" Padding="14,8" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Queued Items List -->
                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedItemsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Clear All" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ClearSelectionCommand}"
                                                Visibility="{Binding HasSelectedItems, Converter={StaticResource BoolToVis}}"
                                                Padding="8,3" FontSize="11" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <!-- Empty Queue Placeholder -->
                                            <Grid>
                                                <TextBlock Text="No items in queue. Drag files/folders or use browse buttons."
                                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasSelectedItems, Converter={StaticResource InverseBoolToVis}}" Margin="20" />

                                                <!-- Queue Items -->
                                                <ItemsControl ItemsSource="{Binding SelectedItems}" Margin="6">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="3" Content="✕" ToolTip="Remove from queue"
                                                                            Style="{StaticResource SecondaryButton}"
                                                                            Padding="6,2" FontSize="11"
                                                                            Command="{Binding DataContext.RemoveSelectedItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                                <!-- Send Button -->
                                <Button Grid.Row="3" Content="🚀  SEND FILES OVER ETHERNET"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="48" FontSize="14" FontWeight="Bold"
                                        Command="{Binding StartTransferCommand}"
                                        IsEnabled="{Binding CanSend}" />
                            </Grid>
                        </Border>

                        <!-- View B: LIVE TRANSFER DASHBOARD (when transfer is active) -->
                        <Border Style="{StaticResource GlassCard}" Visibility="{Binding IsTransferActive, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Header -->
                                    <RowDefinition Height="Auto" /> <!-- Progress Bar -->
                                    <RowDefinition Height="*" />    <!-- Metrics Tiles -->
                                    <RowDefinition Height="Auto" /> <!-- Controls -->
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding CurrentProgress.PeerName, StringFormat='{}Active Transfer with {0}'}"
                                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CurrentProgress.CurrentFileName, StringFormat='{}Current: {0}'}"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentProgress.SpeedFormatted}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Progress Bar -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{Binding CurrentProgress.PercentComplete, StringFormat='{}{0:F1}% Completed'}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" />
                                        <TextBlock Text="{Binding CurrentProgress.EtaFormatted, StringFormat='{}ETA: {0}'}"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource ModernProgressBar}"
                                                 Value="{Binding CurrentProgress.PercentComplete}"
                                                 Minimum="0" Maximum="100" Height="12" />
                                </StackPanel>

                                <!-- Metrics Grid -->
                                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,20">
                                    <Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="TRANSFERRED" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CurrentProgress.TransferredBytesFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CurrentProgress.TotalBytesFormatted, StringFormat='{}of {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource MetricTile}" Margin="3,0,3,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="FILES" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CurrentProgress.FilesCompleted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CurrentProgress.TotalFiles, StringFormat='{}of {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource MetricTile}" Margin="3,0,3,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SPEED" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CurrentProgress.SpeedFormatted}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="Streaming TCP" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource MetricTile}" Margin="6,0,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ESTIMATED TIME" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding CurrentProgress.EtaFormatted}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="Remaining" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Transfer Controls -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="⏸  Pause" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PauseTransferCommand}"
                                            Visibility="{Binding IsTransferPaused, Converter={StaticResource InverseBoolToVis}}"
                                            Margin="0,0,10,0" Padding="16,8" />

                                    <Button Content="▶  Resume" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ResumeTransferCommand}"
                                            Visibility="{Binding IsTransferPaused, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,10,0" Padding="16,8" />

                                    <Button Content="⏹  Cancel Transfer" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CancelTransferCommand}" Padding="16,8" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 1.3 Bottom Status Bar -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TransferStatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Zero-Config • Streaming Sockets • 64-bit I/O Pipeline" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- #################################################### -->
                <!-- SECTION 2: GAME UPDATER                               -->
                <!-- #################################################### -->
                <Grid Visibility="{Binding CurrentNavSection, Converter={StaticResource EnumToVis}, ConverterParameter=GameUpdater}">
                    <views:GameUpdaterView DataContext="{Binding GameUpdater}" />
                </Grid>

                <!-- #################################################### -->
                <!-- SECTION 3: ACTIVITY & HISTORY                         -->
                <!-- #################################################### -->
                <Grid Visibility="{Binding CurrentNavSection, Converter={StaticResource EnumToVis}, ConverterParameter=Activity}">
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="📊 Transfer Activity &amp; History" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Audit logs of all completed, cancelled, and recent transfers over Ethernet." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear History" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ClearHistoryCommand}" Padding="12,6" VerticalAlignment="Center" />
                            </Grid>

                            <!-- History Table -->
                            <Border Grid.Row="1" Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="No transfer activity recorded yet." FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding TransferHistory.Count, Converter={StaticResource InverseBoolToVis}}" />

                                    <ListView ItemsSource="{Binding TransferHistory}" Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="12,8" Margin="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="140" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Direction Badge -->
                                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#1E293B">
                                                            <TextBlock Text="{Binding DirectionDisplay}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" />
                                                        </Border>

                                                        <!-- Peer & Files -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PeerName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding TotalFiles, StringFormat='{}{0} file(s)'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>

                                                        <!-- Size -->
                                                        <TextBlock Grid.Column="2" Text="{Binding TotalBytesFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                                        <!-- Speed -->
                                                        <TextBlock Grid.Column="3" Text="{Binding AverageSpeedFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />

                                                        <!-- Status Badge -->
                                                        <Border Grid.Column="4" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#064E3B" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StateDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                                        </Border>

                                                        <!-- Timestamp -->
                                                        <TextBlock Grid.Column="5" Text="{Binding TimestampLocalFormatted}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- #################################################### -->
                <!-- SECTION 4: SETTINGS                                   -->
                <!-- #################################################### -->
                <Grid Visibility="{Binding CurrentNavSection, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}">
                    <Border Style="{StaticResource GlassCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,10,0">
                                <TextBlock Text="⚙ Application &amp; Network Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                                <!-- General Preferences -->
                                <Border Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PC IDENTITY &amp; NETWORK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10" />

                                        <TextBlock Text="Device Name (broadcast to peers):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SettingsDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="0,0,0,12" />

                                        <TextBlock Text="Listening TCP Port:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SettingsTcpPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="0,0,0,12" />
                                    </StackPanel>
                                </Border>

                                <!-- Storage & Downloads -->
                                <Border Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STORAGE &amp; DOWNLOADS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10" />

                                        <TextBlock Text="Default Save Location:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SettingsDefaultDownloadPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" />
                                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding BrowseDownloadPathCommand}" Margin="8,0,0,0" Padding="12,6" />
                                        </Grid>

                                        <TextBlock Text="File Conflict Resolution:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox SelectedItem="{Binding SettingsConflictResolution}"
                                                  ItemsSource="{Binding Source={x:Static vm:MainViewModel.AvailableConflictResolutions}}"
                                                  Margin="0,0,0,12" />
                                    </StackPanel>
                                </Border>

                                <!-- Performance Pipeline -->
                                <Border Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PERFORMANCE &amp; BUFFERING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10" />

                                        <TextBlock Text="TCP Socket Buffer Size:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox SelectedItem="{Binding SettingsBufferSizeBytes}"
                                                  ItemsSource="{Binding AvailableBufferSizes}"
                                                  Margin="0,0,0,12">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='{}{0} bytes'}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="Data Integrity Verification:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox SelectedItem="{Binding SettingsVerificationMode}"
                                                  ItemsSource="{Binding Source={x:Static vm:MainViewModel.AvailableVerificationModes}}"
                                                  Margin="0,0,0,12" />
                                    </StackPanel>
                                </Border>

                                <!-- Save & Firewall Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,10">
                                    <Button Content="🛡 Configure Firewall Rule" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ConfigureFirewallCommand}" Margin="0,0,10,0" Padding="16,8" />
                                    <Button Content="💾 Save Settings" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveSettingsCommand}" Padding="24,8" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3. MODAL OVERLAY: Incoming Transfer Request Drawer           -->
        <!-- ============================================================ -->
        <Border Background="#BF000000" Visibility="{Binding HasPendingIncomingRequest, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource GlassCard}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="📥 Incoming File Transfer Request" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Another PC wants to send files directly over your Ethernet connection." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16" />

                    <!-- Details Card -->
                    <Border Background="{DynamicResource CardBgHoverBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Sender PC:" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                <TextBlock Text="{Binding PendingIncomingRequest.SenderDeviceName}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Total Size:" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                <TextBlock Text="{Binding PendingIncomingRequest.Manifest.TotalSizeFormatted}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Total Files:" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                <TextBlock Text="{Binding PendingIncomingRequest.Manifest.TotalFiles}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Disk Space Check:" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" />
                                <TextBlock Text="✓ Sufficient storage space available" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="13" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Destination Directory -->
                    <TextBlock Text="Destination Folder:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding IncomingDestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" />
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseIncomingFolderCommand}" Margin="8,0,0,0" Padding="12,6" />
                    </Grid>

                    <!-- Actions -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="✕ Decline" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeclineIncomingCommand}" HorizontalAlignment="Left" Padding="18,8" />

                        <Button Grid.Column="1" Content="✓ Accept &amp; Start Transfer" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AcceptIncomingCommand}" Padding="20,8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
