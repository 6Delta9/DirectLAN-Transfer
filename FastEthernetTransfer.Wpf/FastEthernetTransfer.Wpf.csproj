    <ApplicationIcon>newappicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="newappicon.ico" />
    <Resource Include="appicon.ico" />
  </ItemGroup>

</Project>
