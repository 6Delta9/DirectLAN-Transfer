<Window x:Class="FastEthernetTransfer.Wpf.Views.GameUpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FastEthernetTransfer.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="🎮 Game Updater - Differential Ethernet Transfer"
        Height="740" Width="980" MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="pack://application:,,,/newappicon.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Area -->
            <RowDefinition Height="Auto" /> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎮 Game Updater" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Differential • Fast SHA-256" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Transfer only new and changed game files over Ethernet instead of copying entire 100+ GB installations."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#121826" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current State: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding CurrentState}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Main Body Content (State-driven) -->
        <Grid Grid.Row="1">

            <!-- VIEW 1: SETUP STATE -->
            <Border Style="{StaticResource GlassCard}" Visibility="{Binding CurrentState, Converter={StaticResource EnumToVis}, ConverterParameter=Setup}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="1. Configure Source and Destination" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose which remote PC holds the updated game files and select your local destination game folder."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Remote PC Selection -->
                            <Border Background="#0C121D" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SOURCE PC (Contains Updated Game)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="Select the remote PC connected to Ethernet:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />

                                    <ComboBox ItemsSource="{Binding AvailablePeers}" SelectedItem="{Binding SelectedPeer}"
                                              Background="#0E1420" Foreground="{StaticResource TextPrimaryBrush}" Padding="10,8" Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🖥 " FontSize="14" />
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="4,0,6,0" />
                                                    <TextBlock Text="{Binding LinkSpeedFormatted, StringFormat='{}• {0}'}" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding IpAddress, StringFormat='{}[{0}]'}" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="The remote PC will display a folder-selection prompt to approve the update source directory."
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Destination Local Folder Selection -->
                            <Border Background="#0C121D" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    AllowDrop="True" Drop="OnDestinationFolderDrop" DragOver="OnDestinationFolderDragOver">
                                <StackPanel>
                                    <TextBlock Text="DESTINATION FOLDER (Local Game Installation to Update)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="Select or drag and drop your local game directory or game executable here:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LocalGameFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#0E1420" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}" Padding="10,8" />
                                        <Button Grid.Column="1" Content="Browse Folder..."
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding BrowseLocalFolderCommand}" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="Tip: Drag &amp; drop any game folder or game .exe directly into this box."
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Safety & Integrity Guarantee Box -->
                            <Border Background="#101726" CornerRadius="8" Padding="14" BorderBrush="#1E293B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🛡 Game Integrity &amp; Safety" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                    <TextBlock Text="• File comparison compares actual SHA-256 content hashes, not just modification dates.&#x0a;• Identical files are skipped entirely to save bandwidth.&#x0a;• Destination-only files (saves, configs, mods) are preserved safely by default.&#x0a;• Transferred files are verified before final replacement using temporary part files."
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" LineHeight="18" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="🔍  CONNECT &amp; COMPARE GAME FOLDERS"
                            Style="{StaticResource PrimaryButton}"
                            Height="48" FontSize="14" FontWeight="Bold"
                            Command="{Binding RequestRemoteFolderCommand}"
                            IsEnabled="{Binding CanRequestRemoteFolder}"
                            Margin="0,16,0,0" />
                </Grid>
            </Border>

            <!-- VIEW 2: SCANNING & COMPARING STATE -->
            <Border Style="{StaticResource GlassCard}" Visibility="{Binding CurrentState, Converter={StaticResource EnumToVis}, ConverterParameter='Scanning,Comparing'}">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Comparing Game Installations..." FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ScanProgressText}" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" />

                        <ProgressBar Style="{StaticResource ModernProgressBar}"
                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                     Value="{Binding ScanProgressPercent}"
                                     Minimum="0" Maximum="100"
                                     Height="10" Width="480" Margin="0,0,0,24" />

                        <Button Content="✕ Cancel Operation" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}" HorizontalAlignment="Center" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIEW 3: REVIEW CHANGES STATE -->
            <Border Style="{StaticResource GlassCard}" Visibility="{Binding CurrentState, Converter={StaticResource EnumToVis}, ConverterParameter=ReviewChanges}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Summary Metrics -->
                        <RowDefinition Height="Auto" /> <!-- Filters Bar -->
                        <RowDefinition Height="*" />    <!-- File Differences DataGrid/List -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Action & Options Bar -->
                    </Grid.RowDefinitions>

                    <!-- Summary Metrics Tiles (5 items) -->
                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,14">
                        <!-- New Files -->
                        <Border Style="{StaticResource MetricTile}" Margin="0,0,4,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NEW FILES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding NewFilesCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Will be transferred" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Changed Files -->
                        <Border Style="{StaticResource MetricTile}" Margin="2,0,2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CHANGED FILES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ChangedFilesCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Will be updated" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Identical Files -->
                        <Border Style="{StaticResource MetricTile}" Margin="2,0,2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="IDENTICAL FILES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding IdenticalFilesCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Skipped (Already match)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Destination Only -->
                        <Border Style="{StaticResource MetricTile}" Margin="2,0,2,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DESTINATION ONLY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding DestOnlyFilesCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentRoseBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Kept by default" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Total to Transfer -->
                        <Border Style="{StaticResource MetricTile}" Margin="4,0,0,0" Background="#0C1B2E" BorderBrush="{StaticResource AccentCyanBrush}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL TO TRANSFER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                <TextBlock Text="{Binding TotalTransferSizeFormatted}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding TotalTransferFiles, StringFormat='{}{0} file(s)'}" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Filter by: " VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="12" />
                            <Button Content="All Changes" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" Command="{Binding SetFilterCommand}" CommandParameter="All Changes" />
                            <Button Content="New" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" Command="{Binding SetFilterCommand}" CommandParameter="New" />
                            <Button Content="Changed" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" Command="{Binding SetFilterCommand}" CommandParameter="Changed" />
                            <Button Content="Identical" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" Command="{Binding SetFilterCommand}" CommandParameter="Identical" />
                            <Button Content="Destination-Only" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0" Command="{Binding SetFilterCommand}" CommandParameter="Destination-Only" />
                            <Button Content="All Files" Style="{StaticResource SecondaryButton}" Padding="10,4" Command="{Binding SetFilterCommand}" CommandParameter="All Files" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding FilteredFiles.Count, StringFormat='{}Showing {0} items'}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Differences List -->
                    <Border Grid.Row="2" Background="#0C121D" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ListView ItemsSource="{Binding FilteredFiles}" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextPrimaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding RelativePath}" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,16,0" />

                                        <Border Grid.Column="2" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right"
                                                Background="#172033" BorderBrush="{Binding ResultColor}" BorderThickness="1">
                                            <TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Bottom Action & Options Bar -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Optional Deletion of Destination-Only Files -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <CheckBox Content="Remove files that do not exist in the source (create exact mirror)"
                                      IsChecked="{Binding RemoveDestOnlyFiles}"
                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="Caution: Only enable if you want to delete mods, configs, and old game files."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="20,2,0,0" />
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="← Back" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BackToSetupCommand}" Margin="0,0,10,0" Padding="18,10" />

                            <Button Content="🚀  START GAME UPDATE" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartUpdateCommand}"
                                    IsEnabled="{Binding CanStartUpdate}"
                                    Padding="24,10" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- VIEW 4: TRANSFERRING STATE -->
            <Border Style="{StaticResource GlassCard}" Visibility="{Binding CurrentState, Converter={StaticResource EnumToVis}, ConverterParameter=Transferring}">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Updating Game Files Over Ethernet" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Files are being streamed directly through the high-speed Ethernet pipeline."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20" />

                        <Border Background="#0C121D" CornerRadius="8" Padding="16" Width="560" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Source PC:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedPeer.DeviceName}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Destination Folder:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                                    <TextBlock Text="{Binding LocalGameFolder}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Total Transfer Size:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                                    <TextBlock Text="{Binding TotalTransferSizeFormatted}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ProgressBar Style="{StaticResource ModernProgressBar}" IsIndeterminate="True" Height="10" Width="560" Margin="0,0,0,20" />

                        <Button Content="✕ Cancel Update" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}" HorizontalAlignment="Center" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIEW 5: COMPLETED STATE -->
            <Border Style="{StaticResource GlassCard}" Visibility="{Binding CurrentState, Converter={StaticResource EnumToVis}, ConverterParameter=Completed}">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Game Updated Successfully!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AccentEmeraldBrush}" />
                        <TextBlock Text="All new and changed files have been verified and transferred to your game directory."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,8,0,24" TextWrapping="Wrap" />

                        <Button Content="✓ Back to Setup" Style="{StaticResource PrimaryButton}"
                                Command="{Binding BackToSetupCommand}" HorizontalAlignment="Center" Padding="30,12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIEW 6: ERROR STATE -->
            <Border Style="{StaticResource GlassCard}" Visibility="{Binding CurrentState, Converter={StaticResource EnumToVis}, ConverterParameter=Error}">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Game Update Notice" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AccentRoseBrush}" />
                        <TextBlock Text="{Binding ErrorMessage, FallbackValue='An error occurred during game update.'}"
                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,10,0,24" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Try Again" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RetryCommand}" Margin="0,0,10,0" Padding="24,10" />
                            <Button Content="Back to Setup" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BackToSetupCommand}" Padding="20,10" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Differential SHA-256 Engine • High-Speed TCP" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
